# Listening address/port (host networking). Use a LAN-only address or put behind a reverse proxy.
BIND_HOST=0.0.0.0
PORT=8080
# HTTPS switch: auto (default: HTTPS when a certificate is uploaded in Settings), 0/http = always HTTP, 1/https = require the certificate
HTTPS=auto
# Optional: require header X-Access-Token for /api (the UI prompts for it)
ACCESS_TOKEN=
LOG_LEVEL=INFO
# Database (SQLite default; PostgreSQL later: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:////data/scanner.db

# --- Initial integration defaults (all editable later in Settings; values saved in GUI win) ---
DOCKHAND_ENABLED=false
DOCKHAND_URL=
DOCKHAND_TOKEN=
PROXMOX_ENABLED=false
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
ESPHOME_ENABLED=false
ESPHOME_DASHBOARD_URL=

# Password for the Settings page (optional; if empty, set it in the UI on first visit)
SETTINGS_PASSWORD=
